# Database connection (Neon PostgreSQL)
# DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Better Auth Configuration
BETTER_AUTH_SECRET=jeju-weekend-consumption-local-secret-32-chars-min
BETTER_AUTH_URL=http://localhost:3000

# Admin emails (comma-separated list)
ADMIN_EMAILS=admin@example.com

# Jeju Data Hub 608 API
JEJUDATAHUB_DATASET_URL=https://open.jejudatahub.net/api/proxy/
JEJUDATAHUB_API_KEY=your_api_key_here

# Cron Secret for /api/cron
CRON_SECRET=your_cron_secret_here

# Google Gemini API (소상공인 맞춤형 AI 상권 브리핑 및 자연어 질의 강화)
GEMINI_API_KEY=your_gemini_api_key_here
